# quake-lake reads these from the environment (it does not load a .env file
# itself; export them in your shell or use a tool such as direnv).
# `docker compose` does read a .env file next to compose.yaml.

# Where bronze and silver objects go. A local folder (the default) needs nothing else.
# BRONZE_URI=lake/bronze
# SILVER_URI=lake/silver
# Gold (dbt): the DuckDB file it builds. Its folder must exist. dbt reads silver from
# SILVER_URI: a local folder with the default target, s3:// with DBT_TARGET=minio (which
# compose.yaml sets for the Airflow services, with its own MinIO endpoint and the
# MINIO_ROOT_* credentials below).
# GOLD_DB=lake/gold.duckdb

# Airflow (docker compose up): the first day the daily DAG catches up from (one run per
# day, about 10 s each), and the secret its components sign their API tokens with.
# QUAKE_LAKE_START_DATE=2026-11-20
# AIRFLOW_JWT_SECRET=quake-lake-local

# The local MinIO from compose.yaml (`make minio` starts it and creates the `lake` bucket).
# Local-only credentials for a container bound to 127.0.0.1; pick your own.
# BRONZE_URI=s3://lake/bronze
# SILVER_URI=s3://lake/silver
# AWS_ENDPOINT_URL_S3=http://127.0.0.1:9000
# AWS_ACCESS_KEY_ID=quakelake
# AWS_SECRET_ACCESS_KEY=quakelake-local
# AWS_REGION=us-east-1
# MINIO_ROOT_USER=quakelake
# MINIO_ROOT_PASSWORD=quakelake-local

# Real AWS: leave AWS_ENDPOINT_URL_S3 unset and use your normal AWS profile.
# BRONZE_URI=s3://<your-bronze-bucket>
# SILVER_URI=s3://<your-silver-bucket>
# AWS_PROFILE=default
